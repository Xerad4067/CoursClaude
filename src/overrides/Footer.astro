---
// Pied de page de Starlight + barre d'outils flottante :
// mode concentration, minuteur de séance (15/25/45 min) et taille du texte.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>

<div class="barre-outils" role="toolbar" aria-label="Outils de séance">
	<button type="button" id="btn-concentration" aria-pressed="false" title="Masquer le menu et les distractions">🎯 Concentration</button>
	<button type="button" id="btn-minuteur" aria-expanded="false" title="Lancer un minuteur de séance">⏲️ <span class="temps" id="temps-minuteur">Minuteur</span></button>
	<div class="menu-minuteur" id="menu-minuteur" hidden>
		<button type="button" data-minutes="15">15 min</button>
		<button type="button" data-minutes="25">25 min</button>
		<button type="button" data-minutes="45">45 min</button>
		<button type="button" data-minutes="0">Arrêter</button>
	</div>
	<button type="button" id="btn-moins" title="Texte plus petit" aria-label="Texte plus petit">A−</button>
	<button type="button" id="btn-plus" title="Texte plus grand" aria-label="Texte plus grand">A+</button>
</div>
<p class="sr-only" id="annonce-minuteur" aria-live="polite"></p>

<script>
	const racine = document.documentElement;
	const lire = (cle: string) => {
		try { return localStorage.getItem(cle); } catch { return null; }
	};
	const ecrire = (cle: string, valeur: string | null) => {
		try { valeur === null ? localStorage.removeItem(cle) : localStorage.setItem(cle, valeur); } catch {}
	};

	// --- Mode concentration ---
	const btnC = document.getElementById('btn-concentration')!;
	const majC = () => btnC.setAttribute('aria-pressed', racine.dataset.concentration === 'on' ? 'true' : 'false');
	btnC.addEventListener('click', () => {
		const actif = racine.dataset.concentration === 'on';
		if (actif) delete racine.dataset.concentration;
		else racine.dataset.concentration = 'on';
		ecrire('cours-concentration', actif ? null : 'on');
		majC();
	});
	majC();

	// --- Taille du texte ---
	const tailles = ['90%', '100%', '112%', '125%', '140%'];
	const appliquerTaille = (pas: number) => {
		const actuelle = lire('cours-taille-texte') || '100%';
		const i = Math.min(tailles.length - 1, Math.max(0, tailles.indexOf(actuelle) + pas));
		racine.style.setProperty('--taille-texte', tailles[i]);
		ecrire('cours-taille-texte', tailles[i]);
	};
	document.getElementById('btn-moins')!.addEventListener('click', () => appliquerTaille(-1));
	document.getElementById('btn-plus')!.addEventListener('click', () => appliquerTaille(1));

	// --- Minuteur de séance (continue de tourner quand tu changes de page) ---
	const btnM = document.getElementById('btn-minuteur')!;
	const menu = document.getElementById('menu-minuteur')!;
	const affichage = document.getElementById('temps-minuteur')!;
	const annonce = document.getElementById('annonce-minuteur')!;
	btnM.addEventListener('click', () => {
		menu.hidden = !menu.hidden;
		btnM.setAttribute('aria-expanded', String(!menu.hidden));
	});
	menu.querySelectorAll('button').forEach((b) => {
		b.addEventListener('click', () => {
			const minutes = Number(b.dataset.minutes);
			ecrire('cours-minuteur-fin', minutes > 0 ? String(Date.now() + minutes * 60000) : null);
			menu.hidden = true;
			btnM.setAttribute('aria-expanded', 'false');
			if (minutes > 0) annonce.textContent = `Minuteur lancé pour ${minutes} minutes.`;
			tic();
		});
	});
	let finAnnoncee = false;
	function tic() {
		const fin = Number(lire('cours-minuteur-fin') || 0);
		if (!fin) {
			affichage.textContent = 'Minuteur';
			return;
		}
		const reste = Math.max(0, fin - Date.now());
		const m = Math.floor(reste / 60000);
		const s = Math.floor((reste % 60000) / 1000);
		affichage.textContent = `${m}:${String(s).padStart(2, '0')}`;
		if (reste === 0 && !finAnnoncee) {
			finAnnoncee = true;
			ecrire('cours-minuteur-fin', null);
			affichage.textContent = 'Bravo !';
			annonce.textContent = 'Séance terminée ! Coche tes étapes et note ta prochaine action.';
			alert('⏰ Séance terminée, bravo !\n\nAvant de partir : coche ce que tu as fini et lis ta « Prochaine action ».');
		}
	}
	tic();
	setInterval(tic, 1000);
</script>
